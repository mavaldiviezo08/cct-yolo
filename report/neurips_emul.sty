% Réplica del formato NeurIPS (caja de texto 5.5x9 in, Times 10/11 pt, título entre reglas).
% Se usa solo si neurips_2025.sty no está en la carpeta; con el archivo oficial, main.tex usa ese.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{neurips_emul}[2026/10/29 NeurIPS look-alike]
\RequirePackage[letterpaper,textwidth=5.5in,textheight=9in,top=1in,headheight=12pt,headsep=25pt,footskip=30pt]{geometry}
\RequirePackage{mathptmx}
\RequirePackage{helvet}
\renewcommand{\normalsize}{%
  \@setfontsize\normalsize\@xpt\@xipt
  \abovedisplayskip 7\p@ \@plus 2\p@ \@minus 5\p@
  \abovedisplayshortskip \z@ \@plus 3\p@
  \belowdisplayskip \abovedisplayskip
  \belowdisplayshortskip 4\p@ \@plus 3\p@ \@minus 3\p@}
\normalsize
\renewcommand{\small}{\@setfontsize\small\@ixpt\@xpt}
\renewcommand{\footnotesize}{\@setfontsize\footnotesize\@ixpt\@xpt}
\renewcommand{\scriptsize}{\@setfontsize\scriptsize\@viipt\@viiipt}
\renewcommand{\large}{\@setfontsize\large\@xiipt{14}}
\renewcommand{\Large}{\@setfontsize\Large\@xivpt{16}}
\renewcommand{\LARGE}{\@setfontsize\LARGE\@xviipt{20}}
\setlength{\parindent}{\z@}
\setlength{\parskip}{5.5\p@}
\renewcommand{\section}{\@startsection{section}{1}{\z@}%
  {-2.0ex \@plus -0.5ex \@minus -0.2ex}{1.5ex \@plus 0.3ex \@minus 0.2ex}{\large\bf\raggedright}}
\renewcommand{\subsection}{\@startsection{subsection}{2}{\z@}%
  {-1.8ex \@plus -0.5ex \@minus -0.2ex}{0.8ex \@plus 0.2ex}{\normalsize\bf\raggedright}}
\renewcommand{\paragraph}{\@startsection{paragraph}{4}{\z@}%
  {1.5ex \@plus 0.5ex \@minus 0.2ex}{-1em}{\normalsize\bf}}
\renewcommand{\@maketitle}{%
  \vbox{\hsize\textwidth\linewidth\hsize
    \vskip 0.1in\hrule height 4\p@\vskip 0.25in\vskip -\parskip
    \centering{\LARGE\bf \@title\par}
    \vskip 0.29in\vskip -\parskip\hrule height 1\p@\vskip 0.09in
    {\begin{tabular}[t]{c}\bf\rule{\z@}{24\p@}\@author\end{tabular}\par}
    \vskip 0.3in \@minus 0.1in}}
\renewenvironment{abstract}%
  {\vskip 0.075in\centerline{\large\bf\abstractname}\vspace{0.5ex}%
   \begin{list}{}{\leftmargin 0.5in\rightmargin 0.5in}\item\relax}
  {\par\end{list}\vskip 1ex}
\def\ps@neuripsfirst{\let\@oddhead\@empty\let\@evenhead\@empty
  \def\@oddfoot{\small Preprint.\hfil\thepage}\let\@evenfoot\@oddfoot}
\g@addto@macro\maketitle{\thispagestyle{neuripsfirst}}
\endinput
